# Optional overrides: uncomment and supply a value only when needed.
# PORT is provided automatically by Railway; unset locally defaults to 3000.
# PORT=
# HOST overrides the listen address. If unset: PORT set -> 0.0.0.0;
# neither set -> 127.0.0.1. Leave HOST unset on Railway.
# HOST=
# Optional; Railway Postgres provides this through a service variable reference.
# DATABASE_URL=
# Optional Railway public URL after first deploy, e.g. https://<app>.up.railway.app
PUBLIC_URL=
# Optional override; derived from PUBLIC_URL + /api/tiktok/callback when set;
# otherwise unset. Production callback: https://senaloerp.online/api/tiktok/callback
# (Partner Center 里改回调并发布、卖家点授权后才有真实 code，见 T10-README.md)。
TIKTOK_REDIRECT_URI=
# T10：Token 加密密钥，只通过 Cloudflare Workers Secrets / 安全环境注入，
# 本地开发也只放本地 .env（已忽略，不提交）。64 位 hex（32 字节）或普通字符串均可，
# 普通字符串会在代码里先 SHA-256 派生；换密钥后旧 Token 与旧 state 一律不可用。
# Never commit a key or paste it into chat.
TOKEN_ENCRYPTION_KEY=
# T10：TikTok 应用凭证，只通过 Cloudflare Workers Secrets / 安全环境注入，
# 绝不写进代码、文档、提交或聊天。缺失时回调会明确返回“未配置应用凭证，无法换 Token”，
# 不会用模拟 Token 冒充真实授权。
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# T10：D1 绑定变量名 DB，数据库 muse-erp，Cloudflare 后台已建好并绑定。
# 本地没有真实 D1 时，回调会明确返回数据库未绑定，不会假装授权成功。

# B0-B3: disabled by default. Never reuse production credentials for tests.
MUSE_ENV=simulation
TIKTOK_OAUTH_ENABLED=false
# Strong random 32+ character bearer credential, server/secure client only.
MUSE_OAUTH_ADMIN_TOKEN=
TIKTOK_SERVICE_ID=
# JSON array of explicitly verified targets, e.g. keys shopId, market, subjectId.
# Subject is the expected seller open_id. No tokens or cipher in this variable.
TIKTOK_SHOP_TARGETS=[]
# Optional relay is rejected unless URL equals this pinned HTTPS origin.
RELAY_URL=
RELAY_SECRET=
RELAY_ALLOWED_ORIGIN=
