{
  "name": "muse-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node scripts/test-local.mjs",
    "db:generate": "drizzle-kit generate",
    "mcp:stdio": "node dist/mcp-stdio.js",
    "mcp:live": "node dist/ai-stdio.js",
    "mcp:smoke": "node scripts/test-local.mjs --mcp-smoke",
    "db:migrate:local": "node scripts/db-migrate-local.mjs",
    "db:verify:local": "bash scripts/db-verify-local.sh",
    "worker:check": "node scripts/worker-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "drizzle-orm": "~0.45.0",
    "fastify": "^5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "miniflare": "5.20261023.3-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.156.0"
  }
}
