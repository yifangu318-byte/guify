{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guify",
  "main": "workers/entry.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "pino": "./node_modules/pino/pino.js"
  },
  "previews": {},
  "keep_vars": true,
  // Dashboard owns runtime enable flags. keep_vars preserves the approved configuration.
  // Missing flags still fail closed in the request handlers.
  "vars": {"MUSE_RELEASE":"2026-11-04-ai-r1"},
  // D1 绑定：变量名 DB，数据库 muse-erp，后台已建好并绑定。
  // 数据库 ID 为 Cloudflare 后台的资源标识（非密钥），部署前请在后台核对一次；
  // Secret（TOKEN_ENCRYPTION_KEY、TIKTOK_APP_KEY、TIKTOK_APP_SECRET）只放
  // Cloudflare 后台 Secrets，绝不写进本文件、代码或提交。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muse-erp",
      "database_id": "a2978531-26d3-4b04-a837-30f031b4b2e5",
      "migrations_dir": "migrations/d1"
    }
  ]
}
